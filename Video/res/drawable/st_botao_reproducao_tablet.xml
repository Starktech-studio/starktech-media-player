<!-- Botão do player do tablet (ícone + nome): sem fundo; ligado (Capítulos aberto) = branco 8 %; toque com ripple. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/st_branco_14">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/st_texto" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_activated="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/st_branco_14" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:drawable="@android:color/transparent" />
        </selector>
    </item>
</ripple>
