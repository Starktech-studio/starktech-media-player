<!--
     Brilho azul do canto superior direito: degradê radial azul 10 % no lugar do
     "filter: blur(140px)" do HTML (sem RenderEffect, que é da API 31).
     Tamanho pela view: TV st_tv_brilho, tablet st_tablet_brilho.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="50%"
        android:startColor="@color/st_brilho_azul"
        android:centerColor="@color/st_brilho_azul_meio"
        android:endColor="@color/st_brilho_azul_fim" />
</shape>
