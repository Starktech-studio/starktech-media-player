<!-- Chip do tipo da pasta (Filmes, Séries, Shows, Ignorar): escolhido = branco; foco ou toque = branco 14 %. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/st_texto" />
            <corners android:radius="?attr/stCantoSelo" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/st_branco_14" />
            <corners android:radius="?attr/stCantoSelo" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/st_branco_14" />
            <corners android:radius="?attr/stCantoSelo" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
