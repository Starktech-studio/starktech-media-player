<!-- Início na barra lateral do tablet (destaque da 1.1): ativo com fundo amarelo 18 % e canto de 18 dp; toque com realce. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/st_branco_8">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/st_texto" />
            <corners android:radius="@dimen/st_tablet_barra_item_canto" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/st_amarelo_18" />
                    <corners android:radius="@dimen/st_tablet_barra_item_canto" />
                </shape>
            </item>
            <item android:drawable="@android:color/transparent" />
        </selector>
    </item>
</ripple>
