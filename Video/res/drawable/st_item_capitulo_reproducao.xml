<!-- Capítulo na lista do player da TV: o atual (selecionado) em azul 18 % com borda azul 55 %; demais sem fundo. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/st_azul_18" />
            <stroke
                android:width="?attr/stBorda"
                android:color="@color/st_azul_55" />
            <corners android:radius="?attr/stCantoBotao" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
