<!-- Capítulo na lista do tablet: #0f172a com borda #1e293b; o atual (selecionado) em azul 16 % com borda azul 50 %. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/st_branco_14">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/st_azul_16" />
                    <stroke
                        android:width="?attr/stBorda"
                        android:color="@color/st_azul_50" />
                    <corners android:radius="?attr/stCantoBotao" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/st_cartao" />
                    <stroke
                        android:width="?attr/stBorda"
                        android:color="@color/st_borda" />
                    <corners android:radius="?attr/stCantoBotao" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
