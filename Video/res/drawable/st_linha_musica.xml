<!-- Linha de música (1.5): em foco ou tocada, um véu branco; a que está tocando, em azul. Canto do botão. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/st_branco_14" />
            <corners android:radius="?attr/stCantoBotao" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/st_branco_14" />
            <corners android:radius="?attr/stCantoBotao" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/st_azul_16" />
            <corners android:radius="?attr/stCantoBotao" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
