<!-- Barra de progresso (ProgressBar horizontal): trilho branco 15 %, avanço azul #3b82f6, pontas redondas. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/st_branco_15" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <scale
            android:scaleGravity="start|center_vertical"
            android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <solid android:color="@color/st_azul" />
                <corners android:radius="100dp" />
            </shape>
        </scale>
    </item>
</layer-list>
