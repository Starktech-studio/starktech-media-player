<!--
     Buscar no TMDB (BuscaTmdbActivity), tv-busca-tmdb.dc.html: "Escolher o filme certo" e Fechar,
     campo e Buscar, resultados (o atual com o selo "Atual") e o texto de ajuda. Medidas da TV ou do
     tablet aplicadas no código; os resultados são criados no código.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/st_tmdb_caixa"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/st_fundo_menu"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/st_tmdb_titulo"
            style="@style/StarkTech.Texto.Titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/st_tmdb_fechar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:background="@drawable/st_botao_secundario"
            android:contentDescription="@string/st_fechar"
            android:foreground="@drawable/st_foco_tv"
            android:scaleType="fitCenter"
            android:src="@drawable/st_ic_fechar"
            app:tint="@color/st_texto" />
    </LinearLayout>

    <TextView
        android:id="@+id/st_tmdb_rotulo"
        style="@style/StarkTech.Texto.Rotulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/st_buscar_tmdb"
        android:textColor="@color/st_texto_apagado" />

    <LinearLayout
        android:id="@+id/st_tmdb_linha_busca"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/st_tmdb_consulta"
            style="@style/StarkTech.Texto.Medio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/st_campo_texto"
            android:hint="@string/st_busca_dica"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:singleLine="true"
            android:textColorHint="@color/st_texto_apagado" />

        <Button
            android:id="@+id/st_tmdb_buscar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/st_buscar_acao" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/st_tmdb_resultados"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/st_tmdb_ajuda"
        style="@style/StarkTech.Texto.Medio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingMultiplier="1.2"
        android:text="@string/st_ajuda_tmdb"
        android:textColor="@color/st_texto_apagado" />
</LinearLayout>
