<!--
     Detalhe do filme ou do show no tablet (DetalheTabletActivity), tablet-detalhe.dc.html:
     Biblioteca (voltar) e Editar, capa e ações, abas Capítulos, Dados técnicos e Elenco (D12).
     Medidas: px do HTML = dp. A página inteira rola: puxar leva os capítulos para cima, sobre o
     lugar da capa e do título, e dá para ver todos, com qualquer quantidade.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/st_fundo">

    <!-- Fundo animado StarkTech (3 manchas de luz), atrás de todo o conteúdo -->
    <br.com.starktechstudio.mediaplayer.comum.FundoAnimado
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none">

    <LinearLayout
        android:id="@+id/st_detalhe_corpo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/st_tablet_margem_h"
        android:paddingTop="@dimen/st_tablet_detalhe_margem_v"
        android:paddingEnd="@dimen/st_tablet_margem_h"
        android:paddingBottom="@dimen/st_tablet_detalhe_margem_v">

        <!-- Biblioteca (voltar) e Editar: 44 px, ícone 18 px -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/st_detalhe_voltar"
                style="@style/StarkTech.Botao.Tablet.Secundario"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/st_tablet_detalhe_topo_botao_altura"
                android:minHeight="0dp"
                android:paddingStart="@dimen/st_tablet_detalhe_topo_botao_padding"
                android:paddingEnd="@dimen/st_tablet_detalhe_topo_botao_padding"
                android:text="@string/st_biblioteca" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Nota do filme assistido (D6, D12): nesta barra, de altura fixa, para não empurrar o bloco da capa nem os botões; montada no código -->
            <br.com.starktechstudio.mediaplayer.comum.EstrelasNota
                android:id="@+id/st_detalhe_nota"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/st_tablet_detalhe_topo_botao_altura"
                android:layout_marginEnd="@dimen/st_tablet_detalhe_botao_espaco"
                android:visibility="gone" />

            <Button
                android:id="@+id/st_detalhe_editar"
                style="@style/StarkTech.Botao.Tablet.Secundario"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/st_tablet_detalhe_topo_botao_altura"
                android:minHeight="0dp"
                android:paddingStart="@dimen/st_tablet_detalhe_topo_botao_padding"
                android:paddingEnd="@dimen/st_tablet_detalhe_topo_botao_padding"
                android:text="@string/st_editar" />
        </LinearLayout>

        <!-- Capa (220x330) e ações, 36 px entre elas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/st_tablet_detalhe_espaco"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/st_detalhe_capa"
                android:layout_width="@dimen/st_tablet_detalhe_capa_largura"
                android:layout_height="@dimen/st_tablet_detalhe_capa_altura"
                android:importantForAccessibility="no"
                android:padding="@dimen/st_tablet_detalhe_capa_padding">

                <ImageView
                    android:layout_width="@dimen/st_tablet_detalhe_capa_icone"
                    android:layout_height="@dimen/st_tablet_detalhe_capa_icone"
                    android:layout_gravity="top|end"
                    android:importantForAccessibility="no"
                    android:id="@+id/st_imagem_reserva"
                    android:src="@drawable/st_ic_imagem"
                    app:tint="@color/st_branco_35" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/st_tablet_detalhe_capa_espaco"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/st_detalhe_tipo"
                    style="@style/StarkTech.Texto.Rotulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/st_tablet_texto_detalhe_rotulo" />

                <TextView
                    android:id="@+id/st_detalhe_titulo"
                    style="@style/StarkTech.Texto.Titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/st_tablet_detalhe_espaco_info"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textSize="@dimen/st_tablet_texto_detalhe_titulo" />

                <!-- Chips: ano, duração, gênero e os técnicos (vídeo em azul); criados no código -->
                <LinearLayout
                    android:id="@+id/st_detalhe_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/st_tablet_detalhe_espaco_info"
                    android:orientation="horizontal" />

                <!-- Sinopse 16 px, line-height 1,55, até 760 px: no máximo 3 linhas, justificada.
                     "Ver mais" abre o resto numa janela: os botões abaixo nunca descem -->
                <TextView
                    android:id="@+id/st_detalhe_sinopse"
                    style="@style/StarkTech.Texto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/st_tablet_detalhe_espaco_info"
                    android:ellipsize="end"
                    android:justificationMode="inter_word"
                    android:lineSpacingMultiplier="1.28"
                    android:maxLines="3"
                    android:maxWidth="@dimen/st_tablet_detalhe_sinopse_largura"
                    android:textColor="@color/st_texto_secundario"
                    android:textSize="@dimen/st_tablet_texto_detalhe_sinopse" />

                <TextView
                    android:id="@+id/st_detalhe_ver_mais"
                    style="@style/StarkTech.Texto.Botao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="2dp"
                    android:text="@string/st_ver_mais"
                    android:textColor="@color/st_azul"
                    android:textSize="@dimen/st_tablet_texto_detalhe_sinopse"
                    android:visibility="gone" />

                <!-- Assistir (56 px), Continuar 04:12 e Áudio e legendas -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/st_tablet_detalhe_botoes_margem"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/st_detalhe_assistir"
                        style="@style/StarkTech.Botao.Tablet.Primario"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/st_tablet_detalhe_botao_altura"
                        android:paddingStart="@dimen/st_tablet_detalhe_botao_padding_primario"
                        android:paddingEnd="@dimen/st_tablet_detalhe_botao_padding_primario"
                        android:text="@string/st_assistir"
                        android:textSize="@dimen/st_tablet_texto_detalhe_botao_primario" />

                    <Button
                        android:id="@+id/st_detalhe_continuar"
                        style="@style/StarkTech.Botao.Tablet.Secundario"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/st_tablet_detalhe_botao_altura"
                        android:layout_marginStart="@dimen/st_tablet_detalhe_botao_espaco"
                        android:paddingStart="@dimen/st_tablet_detalhe_botao_padding"
                        android:paddingEnd="@dimen/st_tablet_detalhe_botao_padding"
                        android:textSize="@dimen/st_tablet_texto_detalhe_botao" />

                    <Button
                        android:id="@+id/st_detalhe_faixas"
                        style="@style/StarkTech.Botao.Tablet.Secundario"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/st_tablet_detalhe_botao_altura"
                        android:layout_marginStart="@dimen/st_tablet_detalhe_botao_espaco"
                        android:paddingStart="@dimen/st_tablet_detalhe_botao_padding"
                        android:paddingEnd="@dimen/st_tablet_detalhe_botao_padding"
                        android:text="@string/st_audio_legendas"
                        android:textSize="@dimen/st_tablet_texto_detalhe_botao" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Abas: borda #1e293b embaixo; ativa com traço azul de 3 px -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/st_tablet_detalhe_espaco">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_gravity="bottom"
                android:background="@color/st_borda"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/st_aba_capitulos"
                    style="@style/StarkTech.Texto.Botao"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/st_tablet_aba_altura"
                    android:layout_marginEnd="@dimen/st_tablet_aba_espaco"
                    android:background="@drawable/st_aba_tablet"
                    android:gravity="center"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/st_capitulos"
                    android:textColor="@color/st_cor_aba_tablet"
                    android:textSize="@dimen/st_tablet_texto_aba" />

                <TextView
                    android:id="@+id/st_aba_dados"
                    style="@style/StarkTech.Texto.Botao"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/st_tablet_aba_altura"
                    android:layout_marginEnd="@dimen/st_tablet_aba_espaco"
                    android:background="@drawable/st_aba_tablet"
                    android:gravity="center"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/st_dados_tecnicos"
                    android:textColor="@color/st_cor_aba_tablet"
                    android:textSize="@dimen/st_tablet_texto_aba" />

                <TextView
                    android:id="@+id/st_aba_elenco"
                    style="@style/StarkTech.Texto.Botao"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/st_tablet_aba_altura"
                    android:layout_marginEnd="@dimen/st_tablet_aba_espaco"
                    android:background="@drawable/st_aba_tablet"
                    android:gravity="center"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/st_elenco"
                    android:textColor="@color/st_cor_aba_tablet"
                    android:textSize="@dimen/st_tablet_texto_aba" />
            </LinearLayout>
        </FrameLayout>

        <!-- Conteúdo da aba (grade de 2 colunas; dados técnicos em 3), criado no código -->
        <LinearLayout
            android:id="@+id/st_detalhe_aba_conteudo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/st_tablet_detalhe_espaco"
            android:orientation="vertical" />
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
