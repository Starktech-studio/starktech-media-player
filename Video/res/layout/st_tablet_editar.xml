<!--
     Editar no tablet (EditarActivity), tablet-editar.dc.html: Fechar, título e "Editar"; Buscar no
     TMDB, Restaurar original e Salvar no topo; capa e fundo à esquerda (a escolhida em destaque,
     com as regras de formato; embaixo, as outras opções do TMDB + Do aparelho); campos à direita
     (criados no código). Medidas: px do HTML = dp.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/st_fundo">

    <br.com.starktechstudio.mediaplayer.comum.FundoAnimado
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/st_editar_corpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/st_tablet_margem_h"
            android:paddingTop="@dimen/st_tablet_detalhe_margem_v"
            android:paddingEnd="@dimen/st_tablet_margem_h"
            android:paddingBottom="@dimen/st_tablet_detalhe_margem_v">

            <!-- Topo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/st_editar_voltar"
                    android:layout_width="@dimen/st_tablet_detalhe_topo_botao_altura"
                    android:layout_height="@dimen/st_tablet_detalhe_topo_botao_altura"
                    android:background="@drawable/st_botao_secundario"
                    android:contentDescription="@string/st_fechar"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/st_ic_fechar"
                    app:tint="@color/st_texto" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/st_editar_nome"
                        style="@style/StarkTech.Texto.Forte"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:textColor="@color/st_texto_apagado"
                        android:textSize="@dimen/st_tablet_texto_editar_nome" />

                    <TextView
                        style="@style/StarkTech.Texto.Titulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/st_editar"
                        android:textSize="@dimen/st_tablet_texto_editar_titulo" />
                </LinearLayout>

                <Button
                    android:id="@+id/st_editar_buscar_tmdb"
                    style="@style/StarkTech.Botao.Tablet.Secundario"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/st_tablet_botao_altura"
                    android:text="@string/st_buscar_tmdb" />

                <Button
                    android:id="@+id/st_editar_restaurar"
                    style="@style/StarkTech.Botao.Tablet.Secundario"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/st_tablet_botao_altura"
                    android:layout_marginStart="10dp"
                    android:text="@string/st_restaurar_original" />

                <Button
                    android:id="@+id/st_editar_salvar"
                    style="@style/StarkTech.Botao.Tablet.Primario"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/st_tablet_botao_altura"
                    android:layout_marginStart="10dp"
                    android:text="@string/st_salvar" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/st_tablet_detalhe_espaco"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Capa e fundo: a escolhida em destaque e as outras opções embaixo (montadas no código) -->
                <LinearLayout
                    android:layout_width="@dimen/st_tablet_editar_coluna"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/StarkTech.Texto.Rotulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/st_capa"
                        android:textColor="@color/st_texto_apagado"
                        android:textSize="@dimen/st_tablet_texto_dados_rotulo" />

                    <LinearLayout
                        android:id="@+id/st_editar_capas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />

                    <TextView
                        style="@style/StarkTech.Texto.Rotulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="@string/st_fundo"
                        android:textColor="@color/st_texto_apagado"
                        android:textSize="@dimen/st_tablet_texto_dados_rotulo" />

                    <LinearLayout
                        android:id="@+id/st_editar_fundos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/st_editar_campos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/st_tablet_editar_espaco"
                    android:layout_weight="1"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
