<!--
     Item da barra lateral do tablet (tablet-biblioteca.dc.html): 84 dp, ícone 30 dp, texto 13 sp Inter 800.
     O nome fica numa linha só: o que não cabe ("Desenhos", "TV Shows", fonte grande do aparelho) diminui até 9 sp.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/st_tablet_barra_item"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/st_item_barra_lateral"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="13dp"
    android:paddingBottom="13dp">

    <ImageView
        android:id="@+id/st_item_barra_icone"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:importantForAccessibility="no"
        app:tint="@color/st_cor_item_barra" />

    <TextView
        android:id="@+id/st_item_barra_texto"
        style="@style/StarkTech.Texto.Botao"
        android:layout_width="match_parent"
        android:layout_height="@dimen/st_tablet_item_barra_texto_altura"
        android:layout_marginTop="7dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textColor="@color/st_cor_item_barra"
        android:textSize="@dimen/st_tablet_texto_item_barra"
        app:autoSizeMaxTextSize="@dimen/st_tablet_texto_item_barra"
        app:autoSizeMinTextSize="9sp"
        app:autoSizeStepGranularity="0.5sp"
        app:autoSizeTextType="uniform" />
</LinearLayout>
