<!--
     Capítulo na aba Capítulos do Detalhe do tablet (CapituloAdapter): miniatura 72x40 com o
     número, nome e início; o capítulo onde o vídeo parou fica em azul (selecionado).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/st_item_capitulo_tablet"
    android:gravity="center_vertical"
    android:minHeight="@dimen/st_tablet_capitulo_altura"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:id="@+id/st_capitulo_miniatura"
        android:layout_width="@dimen/st_tablet_capitulo_miniatura_largura"
        android:layout_height="@dimen/st_tablet_capitulo_miniatura_altura">

        <TextView
            android:id="@+id/st_capitulo_numero"
            style="@style/StarkTech.Texto.Titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:letterSpacing="0"
            android:textColor="@color/st_branco_60"
            android:textSize="@dimen/st_tablet_texto_capitulo_numero" />
    </FrameLayout>

    <TextView
        android:id="@+id/st_capitulo_nome"
        style="@style/StarkTech.Texto.Botao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:textSize="@dimen/st_tablet_texto_capitulo_nome" />

    <TextView
        android:id="@+id/st_capitulo_tempo"
        style="@style/StarkTech.Texto.Forte"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textColor="@color/st_texto_apagado"
        android:textSize="@dimen/st_tablet_texto_capitulo_tempo" />
</LinearLayout>
