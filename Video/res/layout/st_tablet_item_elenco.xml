<!-- Pessoa na aba Elenco do Detalhe do tablet (D12): nome e personagem, no cartão dos capítulos. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/st_fundo_cartao"
    android:gravity="center_vertical"
    android:minHeight="@dimen/st_tablet_capitulo_altura"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/st_elenco_nome"
        style="@style/StarkTech.Texto.Botao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textSize="@dimen/st_tablet_texto_capitulo_nome" />

    <TextView
        android:id="@+id/st_elenco_personagem"
        style="@style/StarkTech.Texto.Forte"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/st_texto_apagado"
        android:textSize="@dimen/st_tablet_texto_capitulo_tempo" />
</LinearLayout>
