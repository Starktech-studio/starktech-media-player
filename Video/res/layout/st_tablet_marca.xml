<!--
     Marca do topo no tablet, como no banner novo: ícone do app (48 dp) + "StarkTech" branco
     (Inter 700) + "Media Player" amarelo #E8AA30 (Inter 800), na mesma linha.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:layout_width="@dimen/st_tablet_marca_icone"
        android:layout_height="@dimen/st_tablet_marca_icone"
        android:importantForAccessibility="no"
        android:src="@drawable/st_icone_app" />

    <!-- Os dois textos na mesma linha de base -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/StarkTech.Texto.Forte"
            android:text="@string/st_marca"
            android:textColor="@color/st_texto"
            android:textSize="@dimen/st_tablet_texto_marca" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            style="@style/StarkTech.Texto.Botao"
            android:text="@string/st_marca_media_player"
            android:textColor="@color/st_amarelo_marca"
            android:textSize="@dimen/st_tablet_texto_marca_sub" />
    </LinearLayout>
</LinearLayout>
