<!--
     Tela principal do tablet (PrincipalTabletActivity), tablet-biblioteca.dc.html:
     barra lateral de 112 dp (logo 56 dp, itens 84 dp) e, à direita, a marca e o selo
     do HD (só na aba Início, como no desenho) e o conteúdo da aba. Medidas: px do HTML = dp.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/st_fundo">

    <!-- Brilho azul do canto (900 px, top -380, right -200) -->
    <View
        android:layout_width="@dimen/st_tablet_brilho"
        android:layout_height="@dimen/st_tablet_brilho"
        android:layout_gravity="top|end"
        android:background="@drawable/st_brilho"
        android:importantForAccessibility="no"
        android:translationX="200dp"
        android:translationY="-380dp" />

    <LinearLayout
        android:id="@+id/st_corpo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Barra lateral -->
        <LinearLayout
            android:id="@+id/st_barra_lateral"
            android:layout_width="@dimen/st_tablet_barra_lateral"
            android:layout_height="match_parent"
            android:background="@color/st_barra_lateral"
            android:contentDescription="@string/st_secoes"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="22dp">

            <ImageView
                android:layout_width="@dimen/st_tablet_barra_logo"
                android:layout_height="@dimen/st_tablet_barra_logo"
                android:layout_marginBottom="14dp"
                android:contentDescription="@string/st_logo"
                android:src="@drawable/st_logo" />
        </LinearLayout>

        <!-- Borda direita da barra (1 px #1e293b) -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/st_borda" />

        <LinearLayout
            android:id="@+id/st_coluna_conteudo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Marca e selo do HD (aba Início) -->
            <LinearLayout
                android:id="@+id/st_topo_inicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/st_tablet_margem_h"
                android:paddingTop="@dimen/st_tablet_margem_v"
                android:paddingEnd="@dimen/st_tablet_margem_h">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/st_marca"
                        style="@style/StarkTech.Texto.Titulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/st_tablet_texto_marca" />

                    <TextView
                        style="@style/StarkTech.Texto.Apagado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/st_marca_media_player"
                        android:textSize="@dimen/st_tablet_texto_marca_sub" />
                </LinearLayout>

                <!-- Selo do HD: verde "HD externo" / vermelho "Sem HD ✕" -->
                <LinearLayout
                    android:id="@+id/st_selo_hd"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/st_tablet_selo_hd_altura"
                    android:background="@drawable/st_selo_hd"
                    android:contentDescription="@string/st_hd_situacao"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:id="@+id/st_selo_hd_icone"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/st_ic_hd"
                        app:tint="@color/st_selo_hd_texto" />

                    <TextView
                        android:id="@+id/st_selo_hd_texto"
                        style="@style/StarkTech.Texto.Botao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/st_hd_conectado"
                        android:textColor="@color/st_selo_hd_texto"
                        android:textSize="@dimen/st_tablet_texto_selo_hd" />

                    <ImageView
                        android:id="@+id/st_selo_hd_fechar"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="10dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/st_ic_fechar"
                        android:visibility="gone"
                        app:tint="@color/st_selo_sem_hd_texto" />
                </LinearLayout>
            </LinearLayout>

            <!-- Conteúdo da aba (Navegacao.conteudoDaAba) -->
            <FrameLayout
                android:id="@+id/st_conteudo"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
