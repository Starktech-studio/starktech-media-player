<!--
     Série no tablet (SerieTabletActivity), sem desenho (D12): o Detalhe do tablet com o conteúdo
     da Série da TV — capa, título, chips, aviso da pasta e o botão do próximo episódio; temporadas
     em abas e os episódios em 2 colunas. Medidas: px do HTML = dp.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/st_fundo">

    <!-- Fundo animado StarkTech (3 manchas de luz), atrás de todo o conteúdo -->
    <br.com.starktechstudio.mediaplayer.comum.FundoAnimado
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/st_serie_corpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/st_tablet_margem_h"
            android:paddingTop="@dimen/st_tablet_detalhe_margem_v"
            android:paddingEnd="@dimen/st_tablet_margem_h"
            android:paddingBottom="@dimen/st_tablet_detalhe_margem_v">

            <!-- Biblioteca (voltar) e Editar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/st_serie_voltar"
                    style="@style/StarkTech.Botao.Tablet.Secundario"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/st_tablet_detalhe_topo_botao_altura"
                    android:minHeight="0dp"
                    android:paddingStart="@dimen/st_tablet_detalhe_topo_botao_padding"
                    android:paddingEnd="@dimen/st_tablet_detalhe_topo_botao_padding"
                    android:text="@string/st_biblioteca" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/st_serie_favoritar"
                    style="@style/StarkTech.Botao.Tablet.Secundario"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/st_tablet_detalhe_topo_botao_altura"
                    android:layout_marginEnd="@dimen/st_tablet_detalhe_botao_espaco"
                    android:minHeight="0dp"
                    android:paddingStart="@dimen/st_tablet_detalhe_topo_botao_padding"
                    android:paddingEnd="@dimen/st_tablet_detalhe_topo_botao_padding"
                    android:text="@string/st_favoritar" />

                <Button
                    android:id="@+id/st_serie_editar"
                    style="@style/StarkTech.Botao.Tablet.Secundario"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/st_tablet_detalhe_topo_botao_altura"
                    android:minHeight="0dp"
                    android:paddingStart="@dimen/st_tablet_detalhe_topo_botao_padding"
                    android:paddingEnd="@dimen/st_tablet_detalhe_topo_botao_padding"
                    android:text="@string/st_editar" />
            </LinearLayout>

            <!-- Capa (220x330) e informações -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/st_tablet_detalhe_espaco"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/st_serie_capa"
                    android:layout_width="@dimen/st_tablet_detalhe_capa_largura"
                    android:layout_height="@dimen/st_tablet_detalhe_capa_altura"
                    android:importantForAccessibility="no"
                    android:padding="@dimen/st_tablet_detalhe_capa_padding">

                    <ImageView
                        android:layout_width="@dimen/st_tablet_detalhe_capa_icone"
                        android:layout_height="@dimen/st_tablet_detalhe_capa_icone"
                        android:layout_gravity="top|end"
                        android:importantForAccessibility="no"
                        android:id="@+id/st_imagem_reserva"
                        android:src="@drawable/st_ic_imagem"
                        app:tint="@color/st_branco_35" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/st_tablet_detalhe_capa_espaco"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        style="@style/StarkTech.Texto.Rotulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/st_tipo_serie"
                        android:textSize="@dimen/st_tablet_texto_detalhe_rotulo" />

                    <TextView
                        android:id="@+id/st_serie_titulo"
                        style="@style/StarkTech.Texto.Titulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/st_tablet_detalhe_espaco_info"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textSize="@dimen/st_tablet_texto_detalhe_titulo" />

                    <LinearLayout
                        android:id="@+id/st_serie_chips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/st_tablet_detalhe_espaco_info"
                        android:orientation="horizontal" />

                    <TextView
                        android:id="@+id/st_serie_aviso"
                        style="@style/StarkTech.Texto.Forte"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/st_tablet_detalhe_espaco_info"
                        android:background="@drawable/st_aviso_pasta"
                        android:drawablePadding="10dp"
                        android:gravity="center_vertical"
                        android:lineSpacingMultiplier="1.15"
                        android:maxWidth="@dimen/st_tablet_detalhe_sinopse_largura"
                        android:paddingStart="@dimen/st_tablet_aviso_padding_h"
                        android:paddingTop="@dimen/st_tablet_aviso_padding_v"
                        android:paddingEnd="@dimen/st_tablet_aviso_padding_h"
                        android:paddingBottom="@dimen/st_tablet_aviso_padding_v"
                        android:textColor="@color/st_texto_secundario"
                        android:textSize="@dimen/st_tablet_texto_aviso" />

                    <Button
                        android:id="@+id/st_serie_principal"
                        style="@style/StarkTech.Botao.Tablet.Primario"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/st_tablet_detalhe_botao_altura"
                        android:layout_marginTop="@dimen/st_tablet_detalhe_botoes_margem"
                        android:paddingStart="@dimen/st_tablet_detalhe_botao_padding_primario"
                        android:paddingEnd="@dimen/st_tablet_detalhe_botao_padding_primario"
                        android:textSize="@dimen/st_tablet_texto_detalhe_botao_primario" />
                </LinearLayout>
            </LinearLayout>

            <!-- Temporadas em abas (D12); criadas no código -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/st_tablet_detalhe_espaco">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_gravity="bottom"
                    android:background="@color/st_borda"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:id="@+id/st_serie_temporadas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </FrameLayout>

            <!-- Episódios em 2 colunas; criados no código -->
            <LinearLayout
                android:id="@+id/st_serie_episodios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/st_tablet_detalhe_espaco"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
