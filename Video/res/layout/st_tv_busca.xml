<!--
     Buscar da TV (BuscaTvActivity, D11 c; sem desenho): Voltar e o campo no topo, grade de capas 2:3
     no padrão das abas Filmes/Séries/Shows embaixo. Medidas: px do HTML / 2.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/st_fundo">

    <br.com.starktechstudio.mediaplayer.comum.FundoAnimado
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/st_tv_margem_lateral"
            android:paddingTop="@dimen/st_tv_margem_topo"
            android:paddingEnd="@dimen/st_tv_margem_lateral">

            <ImageButton
                android:id="@+id/st_busca_voltar"
                android:layout_width="28dp"
                android:layout_height="@dimen/st_tv_botao_icone_altura"
                android:background="@drawable/st_botao_secundario"
                android:contentDescription="@string/st_voltar"
                android:foreground="@drawable/st_foco_tv"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/st_ic_voltar"
                app:tint="@color/st_texto" />

            <!-- Campo com a lupa (64 px) -->
            <EditText
                android:id="@+id/st_busca_campo"
                style="@style/StarkTech.Texto.Medio"
                android:layout_width="0dp"
                android:layout_height="@dimen/st_tv_campo_altura"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/st_campo_texto"
                android:drawablePadding="8dp"
                android:foreground="@drawable/st_foco_tv"
                android:hint="@string/st_busca_dica"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingStart="@dimen/st_tv_campo_padding"
                android:paddingEnd="@dimen/st_tv_campo_padding"
                android:singleLine="true"
                android:textColor="@color/st_texto"
                android:textColorHint="@color/st_texto_apagado"
                android:textSize="@dimen/st_tv_texto_campo" />
        </LinearLayout>

        <TextView
            android:id="@+id/st_busca_vazio"
            style="@style/StarkTech.Texto.Medio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/st_tv_margem_lateral"
            android:layout_marginTop="@dimen/st_tv_lista_margem_topo"
            android:textColor="@color/st_texto_apagado"
            android:textSize="@dimen/st_tv_texto_corpo" />

        <androidx.leanback.widget.VerticalGridView
            android:id="@+id/st_busca_grade"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="11dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="@dimen/st_tv_fileira_inicio"
            android:paddingTop="@dimen/st_tv_fileira_topo"
            android:paddingEnd="@dimen/st_tv_margem_lateral"
            android:paddingBottom="@dimen/st_tv_margem_topo" />
    </LinearLayout>
</FrameLayout>
