<!--
     Coletânea e artista na TV (ColetaneaArtistaTvActivity), no padrão do Detalhe: fundo atrás, barra
     do topo com a seção marcada e Configurações, capa e, ao lado, nome, chips, texto e Editar; embaixo,
     com título próprio, as capas dos filmes ou dos shows, criadas no código. A página rola até a capa em foco.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/st_fundo">

    <!-- Fundo animado StarkTech (3 manchas de luz), atrás de todo o conteúdo -->
    <br.com.starktechstudio.mediaplayer.comum.FundoAnimado
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false">

            <!-- Fundo (560 px): com o véu 72 % e a base sumindo no fundo animado -->
            <FrameLayout
                android:id="@+id/st_coletanea_fundo"
                android:layout_width="match_parent"
                android:layout_height="@dimen/st_tv_serie_fundo_altura"
                android:importantForAccessibility="no">

                <ImageView
                    android:id="@+id/st_imagem_reserva_fundo"
                    android:layout_width="@dimen/st_tv_detalhe_fundo_icone"
                    android:layout_height="@dimen/st_tv_detalhe_fundo_icone"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="@dimen/st_tv_detalhe_fundo_icone_margem"
                    android:alpha="0.28"
                    android:importantForAccessibility="no"
                    android:src="@drawable/st_ic_imagem"
                    app:tint="@color/st_branco_10" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingBottom="@dimen/st_tv_detalhe_capitulos_base">

                <!-- Topo: marca, seções e Configurações -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/st_tv_margem_lateral"
                    android:paddingTop="@dimen/st_tv_margem_topo"
                    android:paddingEnd="@dimen/st_tv_margem_lateral">

                    <include layout="@layout/st_tv_marca" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/st_secoes"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/st_pilula_inicio"
                            style="@style/StarkTech.Pilula.Tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/st_pilula_menu_inicio"
                            android:text="@string/st_aba_inicio"
                            android:textColor="@color/st_cor_pilula_inicio" />

                        <TextView
                            android:id="@+id/st_pilula_filmes"
                            style="@style/StarkTech.Pilula.Tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/st_tv_pilula_espaco"
                            android:text="@string/st_aba_filmes" />

                        <TextView
                            android:id="@+id/st_pilula_series"
                            style="@style/StarkTech.Pilula.Tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/st_tv_pilula_espaco"
                            android:text="@string/st_aba_series" />

                        <TextView
                            android:id="@+id/st_pilula_tvshows"
                            style="@style/StarkTech.Pilula.Tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/st_tv_pilula_espaco"
                            android:text="@string/st_aba_tvshows"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/st_pilula_desenhos"
                            style="@style/StarkTech.Pilula.Tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/st_tv_pilula_espaco"
                            android:text="@string/st_aba_desenhos" />

                        <TextView
                            android:id="@+id/st_pilula_shows"
                            style="@style/StarkTech.Pilula.Tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/st_tv_pilula_espaco"
                            android:text="@string/st_aba_shows" />

                        <TextView
                            android:id="@+id/st_pilula_standup"
                            style="@style/StarkTech.Pilula.Tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/st_tv_pilula_espaco"
                            android:text="@string/st_aba_standup" />

                        <TextView
                            android:id="@+id/st_pilula_musicas"
                            style="@style/StarkTech.Pilula.Tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/st_tv_pilula_espaco"
                            android:text="@string/st_aba_musicas"
                            android:visibility="gone" />
                    </LinearLayout>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/st_botao_configuracoes"
                        android:layout_width="29dp"
                        android:layout_height="@dimen/st_tv_botao_icone_altura"
                        android:background="@drawable/st_botao_secundario"
                        android:contentDescription="@string/st_configuracoes"
                        android:focusable="true"
                        android:foreground="@drawable/st_foco_tv"
                        android:paddingStart="@dimen/st_tv_botao_icone_padding"
                        android:paddingTop="7.5dp"
                        android:paddingEnd="@dimen/st_tv_botao_icone_padding"
                        android:paddingBottom="7.5dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/st_ic_ajustes"
                        app:tint="@color/st_texto" />

                    <include layout="@layout/st_tv_relogio" />
                </LinearLayout>

                <!-- Capa (250x375 px) e informações, alinhadas embaixo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/st_tv_margem_lateral"
                    android:layout_marginTop="@dimen/st_tv_detalhe_margem_topo"
                    android:layout_marginEnd="@dimen/st_tv_margem_lateral"
                    android:baselineAligned="false"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/st_coletanea_capa"
                        android:layout_width="@dimen/st_tv_serie_capa_largura"
                        android:layout_height="@dimen/st_tv_serie_capa_altura"
                        android:importantForAccessibility="no"
                        android:padding="@dimen/st_tv_serie_capa_padding">

                        <ImageView
                            android:id="@+id/st_imagem_reserva"
                            android:layout_width="@dimen/st_tv_serie_capa_icone"
                            android:layout_height="@dimen/st_tv_serie_capa_icone"
                            android:layout_gravity="top|end"
                            android:importantForAccessibility="no"
                            android:src="@drawable/st_ic_imagem"
                            app:tint="@color/st_branco_35" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/st_tv_serie_espaco"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/st_coletanea_rotulo"
                            style="@style/StarkTech.Texto.Rotulo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/st_tv_texto_rotulo" />

                        <TextView
                            android:id="@+id/st_coletanea_titulo"
                            style="@style/StarkTech.Texto.Titulo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/st_tv_serie_espaco_info"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textSize="@dimen/st_tv_texto_serie_titulo" />

                        <!-- Chip: quantos filmes ou shows; criado no código -->
                        <LinearLayout
                            android:id="@+id/st_coletanea_chips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/st_tv_serie_espaco_info"
                            android:orientation="horizontal" />

                        <!-- Texto: até 4 linhas; o resto em "Ver mais", numa janela -->
                        <TextView
                            android:id="@+id/st_coletanea_sinopse"
                            style="@style/StarkTech.Texto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/st_tv_serie_espaco_info"
                            android:ellipsize="end"
                            android:lineSpacingMultiplier="1.24"
                            android:maxLines="4"
                            android:maxWidth="@dimen/st_tv_detalhe_sinopse_largura"
                            android:textColor="@color/st_texto_secundario"
                            android:textSize="@dimen/st_tv_texto_detalhe_sinopse"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/st_coletanea_fonte"
                            style="@style/StarkTech.Texto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/st_fonte_wikipedia"
                            android:textColor="@color/st_texto_apagado"
                            android:textSize="@dimen/st_tv_texto_menu_dica"
                            android:visibility="gone" />

                        <!-- Editar e Ver mais -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/st_tv_coletanea_acoes_margem"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/st_coletanea_editar"
                                style="@style/StarkTech.Botao.Tv.Secundario"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/st_tv_botao_altura"
                                android:text="@string/st_editar" />

                            <Button
                                android:id="@+id/st_coletanea_ver_mais"
                                style="@style/StarkTech.Botao.Tv.Secundario"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/st_tv_botao_altura"
                                android:layout_marginStart="@dimen/st_tv_coletanea_acao_espaco"
                                android:text="@string/st_ver_mais"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Título da seção: destaca os shows do artista -->
                <TextView
                    android:id="@+id/st_coletanea_secao"
                    style="@style/StarkTech.Texto.Titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/st_tv_margem_lateral"
                    android:layout_marginTop="@dimen/st_tv_temporadas_margem_topo"
                    android:layout_marginEnd="@dimen/st_tv_margem_lateral"
                    android:letterSpacing="0"
                    android:textSize="@dimen/st_tv_texto_titulo_secao" />

                <!-- Capas: 6 por linha, como nas abas; criadas no código -->
                <LinearLayout
                    android:id="@+id/st_coletanea_capas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/st_tv_margem_lateral"
                    android:layout_marginTop="@dimen/st_tv_coletanea_secao_margem"
                    android:layout_marginEnd="@dimen/st_tv_margem_lateral"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</FrameLayout>
