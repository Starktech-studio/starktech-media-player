<!--
     Capa 2:3 da TV (CapaAdapter): Main.dc.html "Filmes adicionados recentemente" e
     tv-menu-capa.dc.html. 196x294 px = 98x147 dp; selo "Assistido" à esquerda, ícone de
     imagem (35 %) à direita; título e ano embaixo. Fundo (bloco de cor) e foco no código.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/st_tv_capa_largura"
    android:layout_height="@dimen/st_tv_capa_altura"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="@dimen/st_tv_capa_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/st_capa_assistido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/st_selo_assistido"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="2dp"
            android:paddingEnd="4dp"
            android:paddingBottom="2dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/st_tv_selo_assistido_icone"
                android:layout_height="@dimen/st_tv_selo_assistido_icone"
                android:importantForAccessibility="no"
                android:src="@drawable/st_ic_check"
                app:tint="@color/st_texto" />

            <TextView
                style="@style/StarkTech.Texto.Botao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:text="@string/st_assistido"
                android:textSize="@dimen/st_tv_texto_selo_assistido" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="@dimen/st_tv_capa_icone"
            android:layout_height="@dimen/st_tv_capa_icone"
            android:alpha="0.35"
            android:importantForAccessibility="no"
            android:src="@drawable/st_ic_imagem"
            app:tint="@color/st_texto" />
    </LinearLayout>

    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/st_capa_titulo"
        style="@style/StarkTech.Texto.Botao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingMultiplier="0.95"
        android:textSize="@dimen/st_tv_texto_capa_titulo" />

    <TextView
        android:id="@+id/st_capa_ano"
        style="@style/StarkTech.Texto.Medio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/st_texto_secundario"
        android:textSize="@dimen/st_tv_texto_capa_sub" />
</LinearLayout>
