<!--
     Capítulo na lista do player da TV (CapituloAdapter), tv-player.dc.html: miniatura 112x63 px com
     o número, nome e início; o atual em azul com o selo "Agora", os já vistos com ✓ verde.
     Foco: borda branca. Medidas: px do HTML / 2.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/st_tv_rep_item_espaco"
    android:background="@drawable/st_item_capitulo_reproducao"
    android:focusable="true"
    android:foreground="@drawable/st_foco_tv"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/st_tv_rep_item_padding_h"
    android:paddingTop="@dimen/st_tv_rep_item_padding_v"
    android:paddingEnd="@dimen/st_tv_rep_item_padding_h"
    android:paddingBottom="@dimen/st_tv_rep_item_padding_v">

    <FrameLayout
        android:id="@+id/st_capitulo_miniatura"
        android:layout_width="@dimen/st_tv_rep_miniatura_largura"
        android:layout_height="@dimen/st_tv_rep_miniatura_altura">

        <TextView
            android:id="@+id/st_capitulo_numero"
            style="@style/StarkTech.Texto.Titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:letterSpacing="0"
            android:textColor="@color/st_branco_60"
            android:textSize="@dimen/st_tv_texto_rep_item_numero" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/st_capitulo_nome"
            style="@style/StarkTech.Texto.Botao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textSize="@dimen/st_tv_texto_rep_item_nome" />

        <TextView
            android:id="@+id/st_capitulo_tempo"
            style="@style/StarkTech.Texto.Apagado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="@dimen/st_tv_texto_rep_item_tempo" />
    </LinearLayout>

    <ImageView
        android:id="@+id/st_capitulo_visto"
        android:layout_width="11dp"
        android:layout_height="11dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@string/st_visto"
        android:src="@drawable/st_ic_check"
        app:tint="@color/st_selo_hd_texto" />

    <TextView
        android:id="@+id/st_capitulo_agora"
        style="@style/StarkTech.Texto.Forte"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="@drawable/st_selo_agora"
        android:paddingStart="4dp"
        android:paddingTop="1.5dp"
        android:paddingEnd="4dp"
        android:paddingBottom="1.5dp"
        android:text="@string/st_agora"
        android:textSize="@dimen/st_tv_texto_rep_agora" />
</LinearLayout>
