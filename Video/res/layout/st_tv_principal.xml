<!--
     Tela principal da TV (PrincipalTvActivity): barra do topo do Main.dc.html
     (marca, pílulas Início, Filmes, Séries, TV Shows, Desenhos, Shows, Stand-up, as ligadas em
     Configurações; botões Buscar e Configurações, relógio) e o conteúdo da aba. Medidas: px do HTML / 2.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/st_fundo"
    android:clipChildren="false">

    <!-- Fundo animado StarkTech (3 manchas de luz), atrás de todo o conteúdo -->
    <br.com.starktechstudio.mediaplayer.comum.FundoAnimado
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/st_barra_topo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/st_tv_margem_lateral"
            android:paddingTop="@dimen/st_tv_margem_topo"
            android:paddingEnd="@dimen/st_tv_margem_lateral">

            <!-- Marca: ícone do app + "StarkTech" + "Media Player" amarelo -->
            <include layout="@layout/st_tv_marca" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Pílulas: uma pílula branca só (indicador) desliza por trás até a aba ativa (200 ms) -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

            <View
                android:id="@+id/st_pilula_indicador"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/st_pilula_indicador"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:id="@+id/st_pilulas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/st_secoes"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/st_pilula_inicio"
                    style="@style/StarkTech.Texto.Forte"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:paddingStart="@dimen/st_tv_pilula_padding_h"
                    android:paddingTop="@dimen/st_tv_pilula_padding_v"
                    android:paddingEnd="@dimen/st_tv_pilula_padding_h"
                    android:paddingBottom="@dimen/st_tv_pilula_padding_v"
                    android:text="@string/st_aba_inicio"
                    android:textColor="@color/st_cor_pilula"
                    android:textSize="@dimen/st_tv_texto_botao" />

                <TextView
                    android:id="@+id/st_pilula_filmes"
                    style="@style/StarkTech.Texto.Forte"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/st_tv_pilula_espaco"
                    android:focusable="true"
                    android:paddingStart="@dimen/st_tv_pilula_padding_h"
                    android:paddingTop="@dimen/st_tv_pilula_padding_v"
                    android:paddingEnd="@dimen/st_tv_pilula_padding_h"
                    android:paddingBottom="@dimen/st_tv_pilula_padding_v"
                    android:text="@string/st_aba_filmes"
                    android:textColor="@color/st_cor_pilula"
                    android:textSize="@dimen/st_tv_texto_botao" />

                <TextView
                    android:id="@+id/st_pilula_series"
                    style="@style/StarkTech.Texto.Forte"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/st_tv_pilula_espaco"
                    android:focusable="true"
                    android:paddingStart="@dimen/st_tv_pilula_padding_h"
                    android:paddingTop="@dimen/st_tv_pilula_padding_v"
                    android:paddingEnd="@dimen/st_tv_pilula_padding_h"
                    android:paddingBottom="@dimen/st_tv_pilula_padding_v"
                    android:text="@string/st_aba_series"
                    android:textColor="@color/st_cor_pilula"
                    android:textSize="@dimen/st_tv_texto_botao" />

                <TextView
                    android:id="@+id/st_pilula_tvshows"
                    style="@style/StarkTech.Texto.Forte"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/st_tv_pilula_espaco"
                    android:focusable="true"
                    android:paddingStart="@dimen/st_tv_pilula_padding_h"
                    android:paddingTop="@dimen/st_tv_pilula_padding_v"
                    android:paddingEnd="@dimen/st_tv_pilula_padding_h"
                    android:paddingBottom="@dimen/st_tv_pilula_padding_v"
                    android:text="@string/st_aba_tvshows"
                    android:textColor="@color/st_cor_pilula"
                    android:textSize="@dimen/st_tv_texto_botao"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/st_pilula_desenhos"
                    style="@style/StarkTech.Texto.Forte"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/st_tv_pilula_espaco"
                    android:focusable="true"
                    android:paddingStart="@dimen/st_tv_pilula_padding_h"
                    android:paddingTop="@dimen/st_tv_pilula_padding_v"
                    android:paddingEnd="@dimen/st_tv_pilula_padding_h"
                    android:paddingBottom="@dimen/st_tv_pilula_padding_v"
                    android:text="@string/st_aba_desenhos"
                    android:textColor="@color/st_cor_pilula"
                    android:textSize="@dimen/st_tv_texto_botao" />

                <TextView
                    android:id="@+id/st_pilula_shows"
                    style="@style/StarkTech.Texto.Forte"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/st_tv_pilula_espaco"
                    android:focusable="true"
                    android:paddingStart="@dimen/st_tv_pilula_padding_h"
                    android:paddingTop="@dimen/st_tv_pilula_padding_v"
                    android:paddingEnd="@dimen/st_tv_pilula_padding_h"
                    android:paddingBottom="@dimen/st_tv_pilula_padding_v"
                    android:text="@string/st_aba_shows"
                    android:textColor="@color/st_cor_pilula"
                    android:textSize="@dimen/st_tv_texto_botao" />

                <TextView
                    android:id="@+id/st_pilula_standup"
                    style="@style/StarkTech.Texto.Forte"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/st_tv_pilula_espaco"
                    android:focusable="true"
                    android:paddingStart="@dimen/st_tv_pilula_padding_h"
                    android:paddingTop="@dimen/st_tv_pilula_padding_v"
                    android:paddingEnd="@dimen/st_tv_pilula_padding_h"
                    android:paddingBottom="@dimen/st_tv_pilula_padding_v"
                    android:text="@string/st_aba_standup"
                    android:textColor="@color/st_cor_pilula"
                    android:textSize="@dimen/st_tv_texto_botao" />

                <TextView
                    android:id="@+id/st_pilula_musicas"
                    style="@style/StarkTech.Texto.Forte"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/st_tv_pilula_espaco"
                    android:focusable="true"
                    android:paddingStart="@dimen/st_tv_pilula_padding_h"
                    android:paddingTop="@dimen/st_tv_pilula_padding_v"
                    android:paddingEnd="@dimen/st_tv_pilula_padding_h"
                    android:paddingBottom="@dimen/st_tv_pilula_padding_v"
                    android:text="@string/st_aba_musicas"
                    android:textColor="@color/st_cor_pilula"
                    android:textSize="@dimen/st_tv_texto_botao"
                    android:visibility="gone" />
            </LinearLayout>
            </FrameLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Buscar e Configurações (56 px, ícone 26 px, espaço 14 px) -->
            <ImageButton
                android:id="@+id/st_botao_buscar"
                android:layout_width="29dp"
                android:layout_height="@dimen/st_tv_botao_icone_altura"
                android:background="@drawable/st_botao_secundario"
                android:contentDescription="@string/st_buscar"
                android:focusable="true"
                android:foreground="@drawable/st_foco_tv"
                android:paddingStart="@dimen/st_tv_botao_icone_padding"
                android:paddingTop="7.5dp"
                android:paddingEnd="@dimen/st_tv_botao_icone_padding"
                android:paddingBottom="7.5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/st_ic_buscar"
                app:tint="@color/st_texto" />

            <ImageButton
                android:id="@+id/st_botao_configuracoes"
                android:layout_width="29dp"
                android:layout_height="@dimen/st_tv_botao_icone_altura"
                android:layout_marginStart="7dp"
                android:background="@drawable/st_botao_secundario"
                android:contentDescription="@string/st_configuracoes"
                android:focusable="true"
                android:foreground="@drawable/st_foco_tv"
                android:paddingStart="@dimen/st_tv_botao_icone_padding"
                android:paddingTop="7.5dp"
                android:paddingEnd="@dimen/st_tv_botao_icone_padding"
                android:paddingBottom="7.5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/st_ic_ajustes"
                app:tint="@color/st_texto" />

            <include layout="@layout/st_tv_relogio" />
        </LinearLayout>

        <!-- Conteúdo da aba (Navegacao.conteudoDaAba) -->
        <FrameLayout
            android:id="@+id/st_conteudo"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false" />
    </LinearLayout>
</FrameLayout>
