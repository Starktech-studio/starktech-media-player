<!--
     Série na TV (SerieTvActivity), tv-serie.dc.html: fundo da série (bloco de cor na F1 + véu 72 %
     + degradê), barra do topo com Séries marcada e "Editar", capa e informações com o aviso da
     pasta, botão do próximo episódio e Favoritar, temporadas e a grade de episódios (2 colunas).
     Medidas: px do HTML / 2. O desenho tem 1280 px: a página rola até o episódio em foco.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/st_fundo">

    <!-- Fundo animado StarkTech (3 manchas de luz), atrás de todo o conteúdo -->
    <br.com.starktechstudio.mediaplayer.comum.FundoAnimado
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:id="@+id/st_serie_rolagem"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false">

            <!-- Fundo da série (560 px): bloco de cor na F1 com o véu 72 % aplicado e a base sumindo no fundo animado; ícone de imagem sob o véu (28 %) -->
            <FrameLayout
                android:id="@+id/st_serie_fundo"
                android:layout_width="match_parent"
                android:layout_height="@dimen/st_tv_serie_fundo_altura"
                android:importantForAccessibility="no">

                <ImageView
                    android:layout_width="@dimen/st_tv_detalhe_fundo_icone"
                    android:layout_height="@dimen/st_tv_detalhe_fundo_icone"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="@dimen/st_tv_detalhe_fundo_icone_margem"
                    android:importantForAccessibility="no"
                    android:alpha="0.28"
                    android:id="@+id/st_imagem_reserva_fundo"
                    android:src="@drawable/st_ic_imagem"
                    app:tint="@color/st_branco_10" />
            </FrameLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingBottom="@dimen/st_tv_detalhe_capitulos_base">

                <!-- Topo: marca, seções (Séries marcada) e Editar + Configurações -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/st_tv_margem_lateral"
                    android:paddingTop="@dimen/st_tv_margem_topo"
                    android:paddingEnd="@dimen/st_tv_margem_lateral">

                    <include layout="@layout/st_tv_marca" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/st_secoes"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/st_pilula_inicio"
                            style="@style/StarkTech.Pilula.Tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/st_pilula_menu_inicio"
                            android:text="@string/st_aba_inicio"
                            android:textColor="@color/st_cor_pilula_inicio" />

                        <TextView
                            android:id="@+id/st_pilula_filmes"
                            style="@style/StarkTech.Pilula.Tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/st_tv_pilula_espaco"
                            android:text="@string/st_aba_filmes" />

                        <TextView
                            android:id="@+id/st_pilula_series"
                            style="@style/StarkTech.Pilula.Tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/st_tv_pilula_espaco"
                            android:text="@string/st_aba_series" />

                        <TextView
                            android:id="@+id/st_pilula_tvshows"
                            style="@style/StarkTech.Pilula.Tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/st_tv_pilula_espaco"
                            android:text="@string/st_aba_tvshows"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/st_pilula_desenhos"
                            style="@style/StarkTech.Pilula.Tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/st_tv_pilula_espaco"
                            android:text="@string/st_aba_desenhos" />

                        <TextView
                            android:id="@+id/st_pilula_shows"
                            style="@style/StarkTech.Pilula.Tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/st_tv_pilula_espaco"
                            android:text="@string/st_aba_shows" />

                        <TextView
                            android:id="@+id/st_pilula_standup"
                            style="@style/StarkTech.Pilula.Tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/st_tv_pilula_espaco"
                            android:text="@string/st_aba_standup" />

                        <TextView
                            android:id="@+id/st_pilula_musicas"
                            style="@style/StarkTech.Pilula.Tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/st_tv_pilula_espaco"
                            android:text="@string/st_aba_musicas"
                            android:visibility="gone" />
                    </LinearLayout>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <!-- Editar só com o ícone (pedido do Gustavo, 31/10/2026) -->
                    <ImageButton
                        android:id="@+id/st_serie_editar"
                        android:layout_width="29dp"
                        android:layout_height="@dimen/st_tv_botao_icone_altura"
                        android:background="@drawable/st_botao_secundario"
                        android:contentDescription="@string/st_editar"
                        android:focusable="true"
                        android:foreground="@drawable/st_foco_tv"
                        android:paddingStart="@dimen/st_tv_botao_icone_padding"
                        android:paddingTop="7.5dp"
                        android:paddingEnd="@dimen/st_tv_botao_icone_padding"
                        android:paddingBottom="7.5dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/st_ic_editar"
                        app:tint="@color/st_texto" />

                    <ImageButton
                        android:id="@+id/st_botao_configuracoes"
                        android:layout_width="29dp"
                        android:layout_height="@dimen/st_tv_botao_icone_altura"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/st_botao_secundario"
                        android:contentDescription="@string/st_configuracoes"
                        android:focusable="true"
                        android:foreground="@drawable/st_foco_tv"
                        android:paddingStart="@dimen/st_tv_botao_icone_padding"
                        android:paddingTop="7.5dp"
                        android:paddingEnd="@dimen/st_tv_botao_icone_padding"
                        android:paddingBottom="7.5dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/st_ic_ajustes"
                        app:tint="@color/st_texto" />

                    <include layout="@layout/st_tv_relogio" />
                </LinearLayout>

                <!-- Capa (250x375 px) e informações, alinhadas embaixo, 56 px entre elas -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/st_tv_margem_lateral"
                    android:layout_marginTop="@dimen/st_tv_detalhe_margem_topo"
                    android:layout_marginEnd="@dimen/st_tv_margem_lateral"
                    android:baselineAligned="false"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/st_serie_capa"
                        android:layout_width="@dimen/st_tv_serie_capa_largura"
                        android:layout_height="@dimen/st_tv_serie_capa_altura"
                        android:importantForAccessibility="no"
                        android:padding="@dimen/st_tv_serie_capa_padding">

                        <ImageView
                            android:layout_width="@dimen/st_tv_serie_capa_icone"
                            android:layout_height="@dimen/st_tv_serie_capa_icone"
                            android:layout_gravity="top|end"
                            android:importantForAccessibility="no"
                            android:id="@+id/st_imagem_reserva"
                            android:src="@drawable/st_ic_imagem"
                            app:tint="@color/st_branco_35" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/st_tv_serie_espaco"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/StarkTech.Texto.Rotulo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/st_tipo_serie"
                            android:textSize="@dimen/st_tv_texto_rotulo" />

                        <TextView
                            android:id="@+id/st_serie_titulo"
                            style="@style/StarkTech.Texto.Titulo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/st_tv_serie_espaco_info"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textSize="@dimen/st_tv_texto_serie_titulo" />

                        <!-- Chips: temporadas, episódios, qualidade; criados no código -->
                        <LinearLayout
                            android:id="@+id/st_serie_chips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/st_tv_serie_espaco_info"
                            android:orientation="horizontal" />

                        <!-- Aviso da pasta (até 1100 px) -->
                        <TextView
                            android:id="@+id/st_serie_aviso"
                            style="@style/StarkTech.Texto.Forte"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/st_tv_serie_espaco_info"
                            android:background="@drawable/st_aviso_pasta"
                            android:drawablePadding="6dp"
                            android:gravity="center_vertical"
                            android:lineSpacingMultiplier="1.15"
                            android:maxWidth="@dimen/st_tv_aviso_largura"
                            android:paddingStart="@dimen/st_tv_aviso_padding_h"
                            android:paddingTop="@dimen/st_tv_aviso_padding_v"
                            android:paddingEnd="@dimen/st_tv_aviso_padding_h"
                            android:paddingBottom="@dimen/st_tv_aviso_padding_v"
                            android:textColor="@color/st_texto_secundario"
                            android:textSize="@dimen/st_tv_texto_aviso" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/st_tv_serie_espaco_info"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/st_serie_principal"
                                style="@style/StarkTech.Botao.Tv.Primario"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/st_tv_botao_altura" />

                            <ImageButton
                                android:id="@+id/st_serie_favoritar"
                                android:contentDescription="@string/st_favoritar"
                                android:layout_width="33dp"
                                android:layout_height="@dimen/st_tv_botao_altura"
                                android:layout_marginStart="@dimen/st_tv_detalhe_botao_espaco"
                                android:background="@drawable/st_botao_secundario"
                                android:focusable="true"
                                android:foreground="@drawable/st_foco_tv"
                                android:paddingStart="10dp"
                                android:paddingTop="9.5dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="9.5dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/st_ic_favorito" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Temporadas (pílulas de 56 px, 12 px entre elas); criadas no código -->
                <LinearLayout
                    android:id="@+id/st_serie_temporadas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/st_tv_margem_lateral"
                    android:layout_marginTop="@dimen/st_tv_temporadas_margem_topo"
                    android:layout_marginEnd="@dimen/st_tv_margem_lateral"
                    android:orientation="horizontal" />

                <!-- Episódios: 2 colunas, 20 px x 28 px; criados no código -->
                <LinearLayout
                    android:id="@+id/st_serie_episodios"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/st_tv_margem_lateral"
                    android:layout_marginTop="@dimen/st_tv_episodios_margem_topo"
                    android:layout_marginEnd="@dimen/st_tv_margem_lateral"
                    android:orientation="vertical" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</FrameLayout>
