<!--
     Tema e estilos da interface StarkTech. Só tema escuro (D18).
     Fonte Inter, um arquivo por peso (res/font/st_inter_*): o peso vem do arquivo,
     não de android:textFontWeight (API 28). Telas novas estendem AppCompatActivity
     para a fonte valer também na API 23-25.

     Atributos st*: medidas que mudam entre TV e tablet, usadas pelos fundos
     de res/drawable/st_*.xml. Esses fundos só funcionam com um tema StarkTech.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <attr name="stBorda" format="dimension" />
    <attr name="stBordaCampo" format="dimension" />
    <attr name="stCantoBotao" format="dimension" />
    <attr name="stCantoCartao" format="dimension" />
    <attr name="stCantoSelo" format="dimension" />

    <!-- Tema base: valores do tablet (px do HTML = dp) -->
    <style name="Theme.StarkTech" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/st_fundo</item>
        <item name="colorPrimaryDark">@color/st_fundo</item>
        <item name="colorAccent">@color/st_azul</item>
        <item name="colorControlNormal">@color/st_texto_secundario</item>
        <item name="colorControlActivated">@color/st_azul</item>
        <item name="colorControlHighlight">@color/st_branco_14</item>
        <item name="android:colorBackground">@color/st_fundo</item>
        <item name="android:windowBackground">@color/st_fundo</item>
        <item name="android:statusBarColor">@color/st_fundo</item>
        <item name="android:navigationBarColor">@color/st_fundo</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:textColorPrimary">@color/st_texto</item>
        <item name="android:textColorSecondary">@color/st_texto_secundario</item>
        <item name="android:textColorHint">@color/st_texto_apagado</item>
        <item name="android:fontFamily">@font/st_inter_medium</item>
        <item name="fontFamily">@font/st_inter_medium</item>

        <item name="stBorda">1dp</item>
        <item name="stBordaCampo">2dp</item>
        <item name="stCantoBotao">@dimen/st_tablet_botao_canto</item>
        <item name="stCantoCartao">16dp</item>
        <item name="stCantoSelo">10dp</item>
    </style>

    <!-- TV: px do HTML / 2 = dp; foco desenhado pelas telas (st_foco_tv), sem o realce padrão -->
    <style name="Theme.StarkTech.Tv">
        <item name="android:defaultFocusHighlightEnabled" tools:targetApi="o">false</item>

        <item name="stBorda">0.5dp</item>
        <item name="stBordaCampo">1dp</item>
        <item name="stCantoBotao">@dimen/st_tv_botao_canto</item>
        <item name="stCantoCartao">8dp</item>
        <item name="stCantoSelo">5dp</item>
    </style>

    <style name="Theme.StarkTech.Tablet" />

    <!-- Texto: Inter 500 (texto), 600, 700, 800 (botões) e 900 (títulos) -->
    <style name="StarkTech.Texto" parent="">
        <item name="android:fontFamily">@font/st_inter_medium</item>
        <item name="fontFamily">@font/st_inter_medium</item>
        <item name="android:textColor">@color/st_texto</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="StarkTech.Texto.Corpo">
        <item name="android:textColor">@color/st_texto_secundario</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="StarkTech.Texto.Medio">
        <item name="android:fontFamily">@font/st_inter_semibold</item>
        <item name="fontFamily">@font/st_inter_semibold</item>
    </style>

    <style name="StarkTech.Texto.Apagado">
        <item name="android:fontFamily">@font/st_inter_semibold</item>
        <item name="fontFamily">@font/st_inter_semibold</item>
        <item name="android:textColor">@color/st_texto_apagado</item>
    </style>

    <style name="StarkTech.Texto.Forte">
        <item name="android:fontFamily">@font/st_inter_bold</item>
        <item name="fontFamily">@font/st_inter_bold</item>
    </style>

    <style name="StarkTech.Texto.Botao">
        <item name="android:fontFamily">@font/st_inter_extrabold</item>
        <item name="fontFamily">@font/st_inter_extrabold</item>
    </style>

    <style name="StarkTech.Texto.Titulo">
        <item name="android:fontFamily">@font/st_inter_black</item>
        <item name="fontFamily">@font/st_inter_black</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- Rótulo em caixa alta, como "NOVIDADES NA BIBLIOTECA" -->
    <style name="StarkTech.Texto.Rotulo">
        <item name="android:fontFamily">@font/st_inter_black</item>
        <item name="fontFamily">@font/st_inter_black</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/st_ciano</item>
    </style>

    <!-- Botões: Inter 800, altura e cantos do desenho -->
    <style name="StarkTech.Botao" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:fontFamily">@font/st_inter_extrabold</item>
        <item name="fontFamily">@font/st_inter_extrabold</item>
        <item name="android:textColor">@color/st_texto</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="StarkTech.Botao.Tv">
        <item name="android:minHeight">@dimen/st_tv_botao_altura</item>
        <item name="android:paddingStart">@dimen/st_tv_botao_padding</item>
        <item name="android:paddingEnd">@dimen/st_tv_botao_padding</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:drawablePadding">@dimen/st_tv_botao_espaco</item>
        <item name="android:textSize">@dimen/st_tv_texto_botao</item>
        <item name="android:foreground">@drawable/st_foco_tv</item>
    </style>

    <style name="StarkTech.Botao.Tv.Primario">
        <item name="android:background">@drawable/st_botao_primario</item>
    </style>

    <style name="StarkTech.Botao.Tv.Secundario">
        <item name="android:background">@drawable/st_botao_secundario</item>
    </style>

    <style name="StarkTech.Botao.Tablet">
        <item name="android:minHeight">@dimen/st_tablet_botao_altura</item>
        <item name="android:paddingStart">@dimen/st_tablet_botao_padding</item>
        <item name="android:paddingEnd">@dimen/st_tablet_botao_padding</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:drawablePadding">@dimen/st_tablet_botao_espaco</item>
        <item name="android:textSize">@dimen/st_tablet_texto_botao</item>
    </style>

    <style name="StarkTech.Botao.Tablet.Primario">
        <item name="android:background">@drawable/st_botao_primario</item>
    </style>

    <style name="StarkTech.Botao.Tablet.Secundario">
        <item name="android:background">@drawable/st_botao_secundario</item>
    </style>
</resources>
