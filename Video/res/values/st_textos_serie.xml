<!-- Textos da Série (F1 fase E): tv-serie.dc.html e o tablet sem desenho (D12). Só pt-BR (D4). -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="pt-BR">

    <plurals name="st_n_temporadas">
        <item quantity="one">%d temporada</item>
        <item quantity="other">%d temporadas</item>
    </plurals>
    <plurals name="st_n_episodios">
        <item quantity="one">%d episódio</item>
        <item quantity="other">%d episódios</item>
    </plurals>

    <!-- Aviso da pasta: "Organizada a partir da pasta Séries / Nome / Temporada 1 / 01.mkv, 02.mkv… — …" -->
    <!-- Entre aspas: o Android corta os espaços das pontas -->
    <string name="st_aviso_pasta_inicio">"Organizada a partir da pasta "</string>
    <string name="st_aviso_pasta_caminho">%1$s / Temporada 1 / 01.mkv, 02.mkv…</string>
    <string name="st_aviso_pasta_fim">" — números viram episódios e os nomes vêm do TMDB"</string>

    <!-- Botão principal: próximo episódio -->
    <string name="st_continuar_episodio">Continuar · Episódio %1$d</string>
    <string name="st_continuar_temporada_episodio">Continuar · T%1$d E%2$d</string>
    <string name="st_assistir_episodio">Assistir · Episódio %1$d</string>
    <string name="st_assistir_temporada_episodio">Assistir · T%1$d E%2$d</string>

    <!-- Temporadas e episódios -->
    <string name="st_temporada_n">Temporada %1$d</string>
    <string name="st_episodio_n">Episódio %1$d</string>
    <string name="st_arquivo_duracao">Arquivo %1$s · %2$d min</string>
    <string name="st_em_andamento">Em andamento</string>
    <string name="st_episodio_descricao">Episódio %1$d: %2$s</string>
</resources>
